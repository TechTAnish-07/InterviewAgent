# ==============================================================================
# LLM Provider Configuration
# Set LOCAL_LLM=true to use local Ollama (e.g. qwen3.5:9b).
# Set LOCAL_LLM=false to use remote cloud providers (e.g. Gemini, OpenAI).
# ==============================================================================
LOCAL_LLM=true
MODEL_NAME=ollama/qwen3.5:9b
SUMMARIZATION_MODEL=ollama/qwen3.5:9b
OLLAMA_API_BASE=http://localhost:11434

# Cloud API Keys (Required if LOCAL_LLM=false or using cloud TTS/STT)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
FISH_API_KEY=

# Server & LiveKit Configuration
PORT=8000
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INFERENCE_API_KEY=
LIVEKIT_INFERENCE_API_SECRET=

# Spring Boot Backend Integration
SPRING_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=internal-secret-key

# Interview Time & Turn Limits
MAX_INTERVIEW_MINUTES=30
WARNING_WINDOW_SECONDS=300
MAX_TURN_COUNT=40
GREETING_SILENCE_DELAY_SECONDS=4.0
TTS_SPEED=1.1

